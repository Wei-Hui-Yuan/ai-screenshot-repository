# Secrets (agents.md §4 rule 1). Only the template is committed.
.env
.env.*
!.env.example

# App data: the SQLite DB and stored screenshots (rule 1). Root only, so
# folders like tests/data/ stay tracked.
/data/

# Safety net: a database outside data/ would still hold text from screenshots
*.db
*.db-*
*.sqlite*

# Screenshots (rule 1): ignored everywhere, so a personal one can't be staged
# by accident. Commit a public-safe eval image on purpose with `git add -f`.
*.png
*.jpg
*.jpeg
*.webp
*.heic

# Eval output: holds text extracted from screenshots
/eval/results/
# Generated by eval/make_synthetic.py; rebuild with `python -m eval.make_synthetic`
/eval/synthetic/

# Python
.venv/
__pycache__/
.pytest_cache/

# Per-user Claude Code permissions
.claude/settings.local.json
