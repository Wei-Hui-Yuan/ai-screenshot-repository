# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.

# Gemini API key from Google AI Studio.
# Free tier: Google may use inputs to improve its products, so only upload non-sensitive screenshots.
GEMINI_API_KEY=

# Gemini model name. gemini-3.1-flash-lite was chosen in the phase 1 spike: fast (3 to 12 s)
# and reliable. gemini-3.5-flash allows only 20 requests per day on the free tier.
GEMINI_MODEL=gemini-3.1-flash-lite
